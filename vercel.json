{
  "installCommand": "echo skip-root-install",
  "buildCommand": "chmod +x build.sh && ./build.sh",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/r/:code", "destination": "/api/r?code=:code" },
    { "source": "/m/:token", "destination": "/manage" },
    { "source": "/j/:code", "destination": "/join" },
    { "source": "/p/:token", "destination": "/passenger" }
  ]
}
